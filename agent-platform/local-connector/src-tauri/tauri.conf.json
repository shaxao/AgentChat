{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AutoCode IDE",
  "version": "0.4.14",
  "identifier": "com.muhuo.autocode.localconnector",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*; frame-src http://localhost:* http://127.0.0.1:*;"
    },
    "windows": [
      {
        "title": "AutoCode IDE",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "useLocalToolsDir": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "targets": [
      "nsis"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://muhuo.site/downloads/autocode/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2RTk3Rjg5ODE5RDY4OTcKUldTWGFKMkJpWC9wdHJnVWtQQ2VndjV4U1doMWhVY2VRSG51dFhDMml6cER5L3REcExUaXRVQWMK",
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "muhuo-autocode"
        ]
      }
    }
  }
}
